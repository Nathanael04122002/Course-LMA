# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Secret Key (Ganti dengan kata kunci rahasia yang kuat di server VPS)
JWT_SECRET=ganti_dengan_jwt_secret_rahasia_dan_panjang_anda

# Database Configuration (MySQL di VPS)
DB_DRIVER=mysql
DB_HOST=localhost
DB_USER=lma_user
DB_PASSWORD=password_database_rahasia
DB_NAME=lma_education_db
DB_PORT=3306

# URL Client (Domain atau IP VPS Anda)
CLIENT_URL=https://lma-education.com
